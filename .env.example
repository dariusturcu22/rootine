# Copy to .env and adjust. Never commit .env.
# These are safe development values only.

# --- Database (PostGIS) ---
POSTGRES_DB=rootine
POSTGRES_USER=rootine
POSTGRES_PASSWORD=rootine_dev_password
DB_URL=jdbc:postgresql://db:5432/rootine
DB_USER=rootine
DB_PASSWORD=rootine_dev_password

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=rootine
RABBITMQ_DEFAULT_PASS=rootine_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rootine
RABBITMQ_PASSWORD=rootine_dev_password

# --- Backend ---
# Placeholder. Generate your own: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
UPLOAD_DIR=/data/uploads
AI_SERVICE_URL=http://ai:8000

# --- Mail (dev: any SMTP, for example a local MailHog/Mailpit) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rootine.local

# --- AI service ---
AI_MOCK=true
MODEL_DIR=/app/models/plant-v1
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
CACHE_TTL=3600
