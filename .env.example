# Copy to .env and adjust. Never commit .env.
# These are safe development values only.

# --- Database (PostGIS) ---
POSTGRES_DB=rootine
POSTGRES_USER=rootine
POSTGRES_PASSWORD=rootine_dev_password
DB_URL=jdbc:postgresql://db:5432/rootine
DB_USER=rootine
DB_PASSWORD=rootine_dev_password

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=rootine
RABBITMQ_DEFAULT_PASS=rootine_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rootine
RABBITMQ_PASSWORD=rootine_dev_password

# --- Backend ---
# Generate a local value with: openssl rand -base64 48
JWT_SECRET=
# Opt in to the local demo explicitly in your ignored .env file.
DEMO_TOKEN_ENABLED=false
VITE_DEMO_MODE=false
UPLOAD_DIR=/data/uploads
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_CONNECT_TIMEOUT=2s
AI_SERVICE_READ_TIMEOUT=30s

# --- Mail (dev: any SMTP, for example a local MailHog/Mailpit) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rootine.local

# --- AI service ---
AI_MOCK=true
MODEL_DIR=/app/models/plant-v1
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
CACHE_TTL=3600
